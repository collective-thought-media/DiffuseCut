PORT=3004
DIFFUSECUT_DATA_DIR=
DIFFUSECUT_DB_PATH=
# Max wait (ms) for ComfyUI HTTP on LAN GPUs (default 15000)
DIFFUSECUT_COMFYUI_TIMEOUT_MS=
# Optional shell command run before each ComfyUI job, so another model server
# can leave the GPU first. Host filter is comma-separated. Empty means every host.
# DIFFUSECUT_GPU_YIELD_COMMAND=
# DIFFUSECUT_GPU_YIELD_HOSTS=

