    {
      "id": "project.render.page",
      "category": "project",
      "label": "Render page: template picker and job list",
      "route": "/projects/{projectId}/render",
      "method": "playwright"
    },
    {
      "id": "project.finishing.trim",
      "category": "project",
      "label": "Finishing: trim in/out on timeline",
