{
  "version": 1,
  "description": "Representative user surface coverage for DiffuseCut E2E eval. Derived from doc/PROJECT-STATUS.md.",
  "surfaces": [
    {
      "id": "global.projects",
      "category": "global",
      "label": "Projects home: create and list",
      "route": "/",
      "method": "playwright"
    },
    {
      "id": "global.setup",
      "category": "global",
      "label": "Setup: system status and re-check",
      "route": "/setup",
      "method": "playwright"
    },
    {
      "id": "global.settings",
      "category": "global",
      "label": "Settings: panels and diagnostic copy",
      "route": "/settings",
      "method": "playwright"
    },
    {
      "id": "project.dashboard",
      "category": "project",
      "label": "Dashboard: logline, plot, visual style, aspect ratio",
      "route": "/projects/{projectId}",
      "method": "api"
    },
    {
      "id": "project.characters.list",
      "category": "project",
      "label": "Characters: list and detail navigation",
      "route": "/projects/{projectId}/characters",
      "method": "playwright"
    },
    {
      "id": "project.characters.create",
