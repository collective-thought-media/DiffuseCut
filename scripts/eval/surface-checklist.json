      "label": "Characters: sheet batch generate and select",
      "route": "/api/projects/{projectId}/characters/.../generate-sheets",
      "method": "api",
      "requiresComfyUI": true
    },
    {
      "id": "project.locations.create",
      "category": "project",
      "label": "Locations: create with states and angles",
      "route": "/api/projects/{projectId}/locations",
      "method": "api"
    },
    {
      "id": "project.locations.generate",
