  "knownGaps": [
    {
      "id": "text-overlays-not-exported",
      "label": "Text overlays preview in Finishing but are not burned into FFmpeg export"
    },
    {
      "id": "export-requires-rendered-shots",
      "label": "Export is blocked until at least one shot has a rendered videoPath"
    },
    {
      "id": "diptych-panel-split-in-progress",
      "label": "Front+back diptych split, per-panel crop, and 16:9 canvas expand is in progress. Not required for eval pass. Use full single-panel select-sheet only."
    }
  ]
}
