    {
      "id": "project.settings.storage",
      "category": "project",
      "label": "Project settings: storage breakdown and orphans",
      "route": "/api/projects/{projectId}/storage",
      "method": "api"
    },
    {
      "id": "project.generation-stack",
      "category": "project",
      "label": "Generation stack: ComfyUI, IP-Adapter, compositing probes",
      "route": "/api/projects/{projectId}/generation-stack",
      "method": "api"
    }
