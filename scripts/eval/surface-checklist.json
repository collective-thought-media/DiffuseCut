      "route": "/api/projects/{projectId}/shots/.../generate-placeholders",
      "method": "api",
      "requiresComfyUI": true
    },
    {
      "id": "project.storyboard.integrate",
      "category": "project",
      "label": "Storyboard: integrate in scene still mode",
      "route": "/api/projects/{projectId}/shots/{shotId}",
      "method": "api",
      "requiresComfyUI": true
    },
    {
      "id": "project.render.settings",
