    },
    {
      "id": "project.finishing.tabs",
      "category": "project",
      "label": "Finishing: score and dialog desk tabs",
      "route": "/projects/{projectId}/finishing",
      "method": "playwright"
    },
    {
      "id": "project.export.queue",
      "category": "project",
      "label": "Export: final video encode",
      "route": "/api/export",
